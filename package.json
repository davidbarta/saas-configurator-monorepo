{
  "name": "saas-configurator-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:vue": "npm run dev -w packages/vue-app",
    "dev:react": "npm run dev -w packages/react-app",
    "dev:api": "npm run dev -w packages/api",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,vue,json,md}\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:vue": "npm run test -w packages/vue-app",
    "test:react": "npm run test -w packages/react-app",
    "type-check": "npm run type-check --workspaces --if-present"
  }
}
